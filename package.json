{
  "name": "quick-translate",
  "description": "Translate the text you select into an anchored popup, with an optional reading/transliteration toggle powered by on-device Chrome AI.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "compile": "tsc --noEmit",
    "dict:ja": "node scripts/copy-kuromoji-dict.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@patdx/kuromoji": "^1.0.4",
    "hangul-romanization": "^1.0.1",
    "phonemizer": "^1.2.1",
    "pinyin-pro": "^3.29.4",
    "preact": "^10.29.8",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.4",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
